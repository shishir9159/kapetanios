	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "bunx --bun vite build",
		"preview": "vite preview",
		"_prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
